# Neon PostgreSQL (required for persistent library + playlists)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:pass@host.neon.tech/nexusemu?sslmode=require

# Gemini API key (required for AI Game Guide + ROM metadata scraping)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Path Configuration (set these to your actual paths on Windows) ───────────

# Root directory of your ROM library
# After setting this, use Vault Manager → SCAN VAULT to index all ROMs
VAULT_ROOT=C:\Games\ROMs

# Directory containing BIOS files (.bin, .rom) for PS1/PS2/GBA/DC etc.
BIOS_PATH=C:\Games\BIOS

# Path to your emulator executable (RetroArch recommended for RTX 3060 Ti Vulkan)
# RetroArch auto-detects the correct core for each ROM platform
EMULATOR_PATH=C:\RetroArch\retroarch.exe

# ─── Optional ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Remote Access (mobile / multi-device) ───────────────────────────────────
# PIN required to authenticate on other devices (set something strong!)
ACCESS_PIN=your_pin_here

# JWT secret for session tokens — generate with: node -e "require('crypto').randomBytes(32).toString('hex')|>console.log"
JWT_SECRET=generate-a-secure-random-hex-string-here

# ─── Ghost Scanner ────────────────────────────────────────────────────────────
# Set to 'false' to disable automatic sorting into platform subfolders
AUTO_SORT=true
